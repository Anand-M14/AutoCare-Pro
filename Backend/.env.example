# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# ---- Supabase ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Backend-only key. Keep the name SUPABASE_KEY until you have verified the key type (npm run check:key).
SUPABASE_KEY=
# Optional: set this to your SECRET / service_role key when you switch keys. It takes priority over SUPABASE_KEY.
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth ----
# At least 32 characters. Generate one with: npm run generate:secret
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# ---- Password migration switches ----
# Keep true until `npm run migrate:passwords -- --apply --i-have-a-backup` has run and login is tested; then set false.
ALLOW_LEGACY_PLAINTEXT_LOGIN=true
# If true, a legacy user's password_hash is written automatically the first time they log in.
AUTO_UPGRADE_LEGACY_PASSWORDS=false

# ---- Email (SendGrid) - set these in your private .env only ----
# Without SENDGRID_API_KEY / SENDGRID_FROM_EMAIL emails are skipped (and logged as "skipped"); nothing else breaks.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=AutoCare Pro
# Public URL of the frontend, used in email links
APP_URL=http://localhost:5173
